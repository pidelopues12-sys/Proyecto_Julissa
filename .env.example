# Plantilla de variables de entorno.
# Copia este archivo a .env y completa los valores reales.
# NO subas .env a git. En producción, configura estas variables en el panel de Vercel.

# Endpoint OpenAI-compatible de NVIDIA (modelo gpt-oss-20b)
NVIDIA_API_KEY=tu-api-key-aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
